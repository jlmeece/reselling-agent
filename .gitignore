# Photo template binaries — local Photoshop exports, iterated constantly. The VPS never runs
# the compositor (no sheet creds); keep layout.json + .gitkeep tracked, drop the big PNGs/JPGs.
data/photo_template/*.png
data/photo_template/*.jpg
data/photo_template/*.jpeg
