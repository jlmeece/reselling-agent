# ============================================================
# WAT Reselling Agent — Environment Template
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# === AGENT CORE ===
ANTHROPIC_API_KEY=

# === GOOGLE ===
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# === GOOGLE APIs ===
YOUTUBE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# === ALERTS ===
# Alert verbosity: "all" (every run), "important" (Tier 1 + errors + sale expiry), "urgent" (errors/OOS only)
ALERT_LEVEL=important
ALERT_FROM_EMAIL=
ALERT_FROM_PASSWORD=
ALERT_TO_EMAIL=
ALERT_TO_SMS=

# === EBAY SELLER HUB ===
# Match exact policy names from: Seller Hub → Account → Business Policies
EBAY_SHIPPING_PROFILE=
EBAY_RETURN_PROFILE=
EBAY_PAYMENT_PROFILE=
EBAY_LOCATION=

# === EBAY TRADING API (tools/ebay_sync.py) ===
# developer.ebay.com keyset. The Trading API authenticates with an OAuth USER token
# (scope https://api.ebay.com/oauth/api_scope) minted from EBAY_OAUTH_REFRESH_TOKEN below and
# sent in the X-EBAY-API-IAF-TOKEN header (cached in data/.ebay_trading_token.json).
# Blank EBAY_OAUTH_REFRESH_TOKEN = ebay_sync skips cleanly; a refused one alerts on Telegram.
# EBAY_APP_ID / EBAY_CERT_ID are also the OAuth client pair (Taxonomy API, refresh grants).
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
# DEPRECATED, unused since 2026-11-01: the old Auth'n'Auth token (hard-expired, error 932).
EBAY_AUTH_TOKEN=
# User OAuth refresh token (~18 months) for Sell Analytics (views), Sell Finances (fees),
# the Media API (photo hosting, sell.inventory) and the Trading API (api_scope).
# Don't paste it by hand (the 2-hour ACCESS token looks alike): run
#   python tools/ebay_consent.py
# which signs you in, swaps the code itself and writes this line (quoted — it holds '#').
EBAY_OAUTH_REFRESH_TOKEN=
# The app's RuName (eBay redirect URI name, developer.ebay.com > User Tokens); used by ebay_consent.py
EBAY_RUNAME=
# HEALTHCHECK_URL_EBAY_SYNC=

# === HERMES GATEWAY (VPS only) ===
TELEGRAM_BOT_TOKEN=      # Bot token from @BotFather on Telegram
TELEGRAM_CHAT_ID=        # Get your chat ID by messaging @userinfobot on Telegram
HERMES_LLM_PROVIDER=anthropic
HERMES_MODEL=claude-sonnet-4-6

# === COOKIE SYNC (GitHub Gist) ===
# Used by tools/cookie_sync.py to push/pull costco_cookies.json between local and VPS.
# Setup: github.com/settings/tokens → New token → check 'gist' scope only.
GITHUB_TOKEN=
GIST_ID=                 # Populated after first run of: python tools/cookie_sync.py upload

# === HEALTHCHECKS (optional — dead-man monitors) ===
HEALTHCHECK_URL_DISCOVERY=
HEALTHCHECK_URL_RESEARCH=
HEALTHCHECK_URL_DAILY=
HEALTHCHECK_URL_ACTIVE=
HEALTHCHECK_URL_AUDIT=
HEALTHCHECK_URL_ROTATION=
HEALTHCHECK_URL_BOT=
